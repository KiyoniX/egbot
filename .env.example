# Secrets du bot. Ne remplissez que ce qui sert a votre installation. Gardez ce fichier prive (chmod 600).

# --- IA qui fait les lecons (selon "agent" dans config.json) ---
# claude : jeton d'abonnement Claude, genere avec : claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# claude : ou bien une cle API Anthropic (facturee a l'usage)
# ANTHROPIC_API_KEY=
# codex : cle API OpenAI (ou une connexion faite avec "codex login", voir le README)
# CODEX_API_KEY=
# gemini : cle API Google AI Studio
# GEMINI_API_KEY=

# --- Mode mail : mot de passe de la boite dediee commune, qui recoit les mails rediriges ---
IMAP_PASSWORD=

# --- Facultatif : URL du webhook Discord qui annonce le resultat de chaque lecon ---
DISCORD_WEBHOOK_URL=

# --- Facultatif, par utilisateur ---
# Ajoutez _ID au nom, ID = son "id" de config.json en majuscules, "-" remplace par "_".
# Une valeur par utilisateur passe avant la valeur commune. Exemples pour l'utilisateur "alex" :
# CLAUDE_CODE_OAUTH_TOKEN_ALEX=   son propre jeton Claude
# CODEX_API_KEY_ALEX=             sa propre cle OpenAI
# GEMINI_API_KEY_ALEX=            sa propre cle Gemini
# IMAP_PASSWORD_ALEX=             mot de passe de sa propre boite, s'il a un bloc "imap" a lui
# LOGIN_LINK_ALEX=                mode web : lien de connexion reutilisable du mail de la plateforme
